rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Signed-in players can look up a profile by its exact Firebase ID.
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id', 'name', 'createdAt'])
        && request.resource.data.id == userId
        && request.resource.data.name is string;
      allow delete: if false;

      match /friends/{friendId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && friendId != userId
          && request.resource.data.keys().hasOnly(['id', 'name'])
          && request.resource.data.id == friendId
          && exists(/databases/$(database)/documents/users/$(friendId));
        allow update: if false;
      }
    }
  }
}
